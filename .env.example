# ============================================
# ARTISAN MARKETPLACE - Environment Variables
# ============================================

# --- Database ---
DATABASE_URL="file:./dev.db"

# --- Authentication ---
AUTH_PROVIDER="development" # "development" (fixed OTP 123456) or "twilio"
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=

# --- Session ---
JWT_SECRET="change-this-to-a-secure-random-string-at-least-32-chars"

# --- AI / LLM ---
# Google Gemini API Key (https://aistudio.google.com)
GEMINI_API_KEY=

# --- Speech-to-Text ---
# OpenAI API Key for Whisper STT (https://platform.openai.com)
OPENAI_API_KEY=

# --- Image Processing ---
# Optional background removal API key (https://www.remove.bg/api)
# If blank, built-in Sharp.js Studio Engine automatically handles local processing
REMOVE_BG_API_KEY=

# --- Market Data ---
MARKET_DATA_PROVIDER="database"
STORAGE_PROVIDER="local"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
PRICING_MIN_MARGIN="20"
PRICING_MAX_MARGIN="35"
DELIVERY_PROCESSING_DAYS_MIN="3"
DELIVERY_PROCESSING_DAYS_MAX="5"
DELIVERY_SHIPPING_DAYS_MIN="3"
DELIVERY_SHIPPING_DAYS_MAX="7"
DELIVERY_BULK_BUFFER_DAYS="5"
