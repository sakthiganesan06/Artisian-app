# ============================================
# ARTISAN MARKETPLACE - Environment Variables
# ============================================

# --- Supabase Cloud Database ---
DATABASE_URL="postgresql://postgres:[YOUR_PASSWORD]@db.[YOUR_PROJECT_REF].supabase.co:5432/postgres"

# --- Supabase Storage & API Keys ---
NEXT_PUBLIC_SUPABASE_URL="https://[YOUR_PROJECT_REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# --- Authentication ---
AUTH_PROVIDER="development"
JWT_SECRET="dev-secret-change-in-production-must-be-32-chars-long"

# --- AI Intelligence Models ---
# Groq API Key for Ultra-Fast Llama 3.3 70B extraction (Free: https://console.groq.com/keys)
GROQ_API_KEY="gsk_..."

# Google Gemini API Key (https://aistudio.google.com)
GEMINI_API_KEY="AQ.Ab8..."

# --- Speech-to-Text ---
# Sarvam AI Key for Indian Languages (https://dashboard.sarvam.ai)
SARVAM_API_KEY="your-sarvam-api-key"

# OpenAI API Key for Whisper STT (https://platform.openai.com)
OPENAI_API_KEY="sk-proj-..."

# --- Optional Background Removal ---
REMOVE_BG_API_KEY=""

# --- App Settings ---
MARKET_DATA_PROVIDER="database"
STORAGE_PROVIDER="local"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
PRICING_MIN_MARGIN="20"
PRICING_MAX_MARGIN="35"
DELIVERY_PROCESSING_DAYS_MIN="3"
DELIVERY_PROCESSING_DAYS_MAX="5"
DELIVERY_SHIPPING_DAYS_MIN="3"
DELIVERY_SHIPPING_DAYS_MAX="7"
DELIVERY_BULK_BUFFER_DAYS="5"
