# ============================================
# ARTISAN MARKETPLACE - Environment Variables
# ============================================

# --- Supabase / PostgreSQL Cloud Database ---
# Format: postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-SUPABASE-PROJECT-REF].supabase.co:5432/postgres?pgbouncer=true
DATABASE_URL="postgresql://postgres:your-password@db.your-project-id.supabase.co:5432/postgres?pgbouncer=true"

# --- Supabase Storage (Cloud Photos & Audio Files) ---
NEXT_PUBLIC_SUPABASE_URL="https://your-project-id.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# --- Authentication ---
AUTH_PROVIDER="development" # "development" (fixed OTP 123456) or "twilio"
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=

# --- Session ---
JWT_SECRET="change-this-to-a-secure-random-string-at-least-32-chars"

# --- AI / LLM ---
# Google Gemini API Key (https://aistudio.google.com)
GEMINI_API_KEY=

# --- Speech-to-Text ---
# Sarvam AI API Key for Indian Language STT (https://dashboard.sarvam.ai)
SARVAM_API_KEY=
# OpenAI API Key for Whisper STT (https://platform.openai.com)
OPENAI_API_KEY=

# --- Image Processing ---
REMOVE_BG_API_KEY=

# --- Market Data ---
MARKET_DATA_PROVIDER="database"
STORAGE_PROVIDER="supabase"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
PRICING_MIN_MARGIN="20"
PRICING_MAX_MARGIN="35"
DELIVERY_PROCESSING_DAYS_MIN="3"
DELIVERY_PROCESSING_DAYS_MAX="5"
DELIVERY_SHIPPING_DAYS_MIN="3"
DELIVERY_SHIPPING_DAYS_MAX="7"
DELIVERY_BULK_BUFFER_DAYS="5"
